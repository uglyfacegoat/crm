DATABASE_URL=postgresql://crm_app:replace-with-the-same-encoded-database-password@database:5432/crm
AUTH_THROTTLE_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
AUTH_EMAIL_OTP_ENABLED=false
# Set the same unique secret in the web and mail worker only after outbound SMTP is verified.
# AUTH_EMAIL_OTP_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_ROOT=/app/storage
CRM_FILE_SCAN_MODE=required
CRM_CLAMD_HOST=clamav
CRM_CLAMD_PORT=3310
CRM_CLAMD_TIMEOUT_MS=10000
# Leave unset to disable intake until a site is connected.
# CRM_WEBSITE_WEBHOOK_SECRET=
CRM_MAIL_ENABLED=false
