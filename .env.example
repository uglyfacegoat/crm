# Local development only. Replace the password before starting PostgreSQL.
CRM_DB_USER=crm_app
CRM_DB_PASSWORD=replace-with-a-long-random-local-password
CRM_DB_NAME=crm
CRM_DB_PORT=54329
CRM_APP_PORT=3000
# Частота фоновой синхронизации системных напоминаний: от 5 секунд до 1 часа.
REMINDER_WORKER_INTERVAL_MS=60000
# Ежедневный backup, минутный heartbeat, повтор через 15 минут после ошибки, хранение 30 дней.
BACKUP_INTERVAL_MS=86400000
BACKUP_WORKER_POLL_MS=60000
BACKUP_RETRY_INTERVAL_MS=900000
BACKUP_RETENTION_DAYS=30
BACKUP_SNAPSHOT_COPY_TIMEOUT_MS=30000
# Необязательный путь на ПК или отдельном диске для второй проверенной копии.
# На Windows можно указать, например, D:/CRM-backups.
CRM_BACKUP_EXPORT_PATH=./backups
DATABASE_URL=postgresql://crm_app:replace-with-a-long-random-local-password@127.0.0.1:54329/crm
# Absolute private directory for uploaded documents during local development.
DOCUMENT_STORAGE_ROOT=C:/crm-storage
# Keep local until the migration/rollback acceptance in docs/OBJECT_STORAGE.md is completed.
DOCUMENT_STORAGE_BACKEND=local
# Required only for s3; bucket must be private and already provisioned. Never use NEXT_PUBLIC_.
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_REGION=
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ACCESS_KEY_ID=
DOCUMENT_S3_SECRET_ACCESS_KEY=
DOCUMENT_S3_FORCE_PATH_STYLE=false
DOCUMENT_S3_TIMEOUT_MS=30000

# Use preview only for local UI work. Required mode enables database-backed authentication.
AUTH_MODE=preview
# Exact browser origins, separated by commas. No wildcards or URL paths.
CRM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Enable only behind a private single ingress that overwrites X-Real-IP.
CRM_TRUST_PROXY=false
# Local Docker is not exposed to the LAN unless explicitly changed.
CRM_BIND_ADDRESS=127.0.0.1
AUTH_THROTTLE_SECRET=replace-with-at-least-32-random-characters
# Общий Bearer-секрет приёма заявок с подключённых сайтов (минимум 32 случайных символа).
CRM_WEBSITE_WEBHOOK_SECRET=replace-with-a-separate-32-character-secret
# Keep false only for a trusted local HTTP deployment. Set true behind HTTPS.
AUTH_COOKIE_SECURE=false

# Used only by `npm run auth:create-admin`; do not commit real credentials.
AUTH_BOOTSTRAP_ORGANIZATION_NAME=ООО ДезСервис
AUTH_BOOTSTRAP_TIMEZONE=Europe/Moscow
AUTH_BOOTSTRAP_ADMIN_NAME=Иван Петров
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.local
AUTH_BOOTSTRAP_ADMIN_PHONE=+79991234567
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
