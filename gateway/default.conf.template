limit_req_zone $binary_remote_addr zone=crm_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=crm_dynamic:10m rate=20r/s;

server {
    listen 80;
    server_name _;
    return 308 ${CRM_PUBLIC_ORIGIN}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;
    ssl_certificate /etc/nginx/certs/certificate.pem;
    ssl_certificate_key /etc/nginx/certs/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 16m;
    limit_req_status 429;

    if ($host != "${CRM_PUBLIC_HOST}") { return 421; }

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Forwarded "";
    proxy_http_version 1.1;
    proxy_read_timeout 60s;

    location = /api/v1/auth/login {
        client_max_body_size 32k;
        limit_req zone=crm_login burst=5 nodelay;
        proxy_pass http://crm:3000;
    }

    location = /login {
        client_max_body_size 32k;
        proxy_pass http://crm:3000;
    }

    location /_next/static/ {
        proxy_pass http://crm:3000;
    }

    location / {
        limit_req zone=crm_dynamic burst=80 nodelay;
        proxy_pass http://crm:3000;
    }
}
