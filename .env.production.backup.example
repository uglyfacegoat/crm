DATABASE_URL=postgresql://crm_app:replace-with-the-same-encoded-database-password@database:5432/crm
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_ROOT=/app/storage
BACKUP_ROOT=/app/backups
BACKUP_EXPORT_ROOT=/app/backup-export
BACKUP_INTERVAL_MS=86400000
BACKUP_WORKER_POLL_MS=60000
BACKUP_RETRY_INTERVAL_MS=900000
BACKUP_RETENTION_DAYS=30
