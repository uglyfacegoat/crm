{
  "name": "crm",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test:migrations": "node --test scripts/migrations.integration.mjs",
    "test:file-drain": "node --test scripts/file-write-drain.integration.mjs",
    "test:file-recovery": "node --test scripts/file-write-recovery.integration.mjs",
    "test:backup-restore": "node --test scripts/backup-restore.integration.mjs",
    "test:request-limits": "node --experimental-test-module-mocks --test scripts/request-limits.integration.mjs",
    "test:startup": "node --test scripts/startup.integration.mjs",
    "test:perimeter": "node scripts/perimeter-check.mjs",
    "test:tls": "node scripts/tls-ingress-check.mjs",
    "test:auth-service": "node --experimental-test-module-mocks --test scripts/auth-service.check.mjs",
    "test:chat-send": "node --experimental-test-module-mocks --test scripts/chat-send.check.mjs",
    "test:upload-commit": "node --experimental-test-module-mocks --test scripts/upload-commit.check.mjs",
    "test:upload-lifecycle": "node --experimental-test-module-mocks --test scripts/upload-lifecycle.check.mjs",
    "test:finance-receipts": "node --experimental-transform-types --experimental-test-module-mocks --test scripts/finance-receipts.integration.mjs",
    "test:uploads-browser": "node scripts/uploads-browser-check.mjs",
    "test:storage-audit": "node --test scripts/storage-audit.integration.mjs",
    "test:s3-storage-audit": "STORAGE_AUDIT_TEST_S3=true node --test scripts/storage-audit.integration.mjs",
    "storage:audit": "node scripts/storage-audit.mjs --check",
    "test:chat-access": "node --experimental-test-module-mocks --test scripts/chat-access.integration.mjs",
    "test:chat-download": "node --experimental-test-module-mocks --test scripts/chat-download.check.mjs",
    "test:document-download": "node --experimental-test-module-mocks --test scripts/document-download.check.mjs",
    "test:s3-storage": "node --test scripts/s3-storage.integration.mjs",
    "test:s3-backup": "node scripts/s3-backup-check.mjs",
    "test:production-smoke": "node scripts/production-smoke-check.mjs",
    "test:sites-production": "node scripts/sites-production-check.mjs",
    "auth:create-admin": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/create-admin.ts",
    "auth:create-member": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/create-member.ts",
    "auth:check": "node --env-file-if-exists=.env.local scripts/auth-flow-check.mjs",
    "charts:check": "node --env-file-if-exists=.env.local scripts/chart-check.mjs",
    "analytics:layout-check": "node --env-file-if-exists=.env.local scripts/analytics-layout-check.mjs",
    "reminders:check": "node --env-file-if-exists=.env.local scripts/reminder-flow-check.mjs",
    "notifications:check": "node --env-file-if-exists=.env.local scripts/notification-flow-check.mjs",
    "orders:copy-check": "node --env-file-if-exists=.env.local scripts/order-copy-flow-check.mjs",
    "orders:edit-check": "node --env-file-if-exists=.env.local scripts/order-edit-flow-check.mjs",
    "tasks:management-check": "node --env-file-if-exists=.env.local scripts/task-management-flow-check.mjs",
    "contracts:check": "node --env-file-if-exists=.env.local scripts/contract-flow-check.mjs",
    "finance:check": "node --env-file-if-exists=.env.local scripts/finance-flow-check.mjs",
    "backup:restore-check": "docker compose --env-file .env.local run --rm --no-deps --entrypoint node backup-worker scripts/backup-restore-check.mjs",
    "backup:ui-check": "node --env-file-if-exists=.env.local scripts/backup-ui-check.mjs",
    "sites:check": "node --env-file-if-exists=.env.local scripts/sites-flow-check.mjs",
    "companies:check": "node --env-file-if-exists=.env.local scripts/company-flow-check.mjs",
    "support:check": "node --env-file-if-exists=.env.local scripts/support-flow-check.mjs",
    "chat:voice-check": "node --env-file-if-exists=.env.local scripts/chat-voice-flow-check.mjs",
    "chat:productivity-check": "node --env-file-if-exists=.env.local scripts/chat-productivity-flow-check.mjs",
    "reminders:worker": "node --env-file-if-exists=.env.local scripts/reminder-worker.mjs",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed-local-example": "node --env-file-if-exists=.env.local scripts/seed-local-example-data.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait database",
    "docker:deploy": "docker compose --env-file .env.local up -d --build --wait",
    "docker:logs": "docker compose --env-file .env.local logs -f crm",
    "docker:down": "docker compose --env-file .env.local down",
    "start": "next start",
    "test": "node --test scripts/*.test.mjs src/lib/*.test.ts src/lib/visits/*.test.ts src/server/analytics/*.test.ts src/server/domain/*.test.ts src/server/auth/*.test.ts src/server/chat/*.test.ts src/server/clients/*.test.ts src/server/contracts/*.test.ts src/server/document-templates/*.test.ts src/server/documents/*.test.ts src/server/finance/*.test.ts src/server/incoming-leads/*.test.ts src/server/masters/*.test.ts src/server/members/*.test.ts src/server/orders/*.test.ts src/server/quick-order/*.test.ts src/server/sites/*.test.ts src/server/support/*.test.ts src/server/tasks/*.test.ts src/server/visits/*.test.ts src/server/http/*.test.ts",
    "lint": "eslint",
    "visual:check": "node --env-file-if-exists=.env.local scripts/visual-check.mjs",
    "help:screenshots": "node --env-file-if-exists=.env.local scripts/help-screenshot-check.mjs",
    "theme:visual-check": "node --env-file-if-exists=.env.local scripts/theme-visual-check.mjs",
    "ui:audit": "node --env-file-if-exists=.env.local scripts/ui-audit.mjs",
    "ui:review-check": "node --env-file-if-exists=.env.local scripts/review-ui-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@fix-webm-duration/fix": "1.0.1",
    "@fix-webm-duration/parser": "1.0.1",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.34.0",
    "mammoth": "1.12.3",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
