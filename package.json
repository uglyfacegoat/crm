{
  "name": "crm",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "auth:create-admin": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/create-admin.ts",
    "auth:create-member": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/create-member.ts",
    "auth:check": "node --env-file-if-exists=.env.local scripts/auth-flow-check.mjs",
    "charts:check": "node --env-file-if-exists=.env.local scripts/chart-check.mjs",
    "reminders:check": "node --env-file-if-exists=.env.local scripts/reminder-flow-check.mjs",
    "notifications:check": "node --env-file-if-exists=.env.local scripts/notification-flow-check.mjs",
    "orders:copy-check": "node --env-file-if-exists=.env.local scripts/order-copy-flow-check.mjs",
    "orders:edit-check": "node --env-file-if-exists=.env.local scripts/order-edit-flow-check.mjs",
    "tasks:management-check": "node --env-file-if-exists=.env.local scripts/task-management-flow-check.mjs",
    "contracts:check": "node --env-file-if-exists=.env.local scripts/contract-flow-check.mjs",
    "finance:check": "node --env-file-if-exists=.env.local scripts/finance-flow-check.mjs",
    "backup:restore-check": "docker compose --env-file .env.local run --rm --no-deps --entrypoint node backup-worker scripts/backup-restore-check.mjs",
    "backup:ui-check": "node --env-file-if-exists=.env.local scripts/backup-ui-check.mjs",
    "import:check": "node --env-file-if-exists=.env.local scripts/import-ui-check.mjs",
    "sites:check": "node --env-file-if-exists=.env.local scripts/sites-flow-check.mjs",
    "support:check": "node --env-file-if-exists=.env.local scripts/support-flow-check.mjs",
    "reminders:worker": "node --env-file-if-exists=.env.local scripts/reminder-worker.mjs",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait database",
    "docker:deploy": "docker compose --env-file .env.local up -d --build --wait",
    "docker:logs": "docker compose --env-file .env.local logs -f crm",
    "docker:down": "docker compose --env-file .env.local down",
    "start": "next start",
    "test": "node --test scripts/*.test.mjs src/lib/*.test.ts src/lib/visits/*.test.ts src/server/analytics/*.test.ts src/server/domain/*.test.ts src/server/auth/*.test.ts src/server/chat/*.test.ts src/server/clients/*.test.ts src/server/contracts/*.test.ts src/server/document-templates/*.test.ts src/server/documents/*.test.ts src/server/finance/*.test.ts src/server/imports/*.test.ts src/server/masters/*.test.ts src/server/members/*.test.ts src/server/orders/*.test.ts src/server/quick-order/*.test.ts src/server/sites/*.test.ts src/server/support/*.test.ts src/server/tasks/*.test.ts src/server/visits/*.test.ts",
    "lint": "eslint",
    "visual:check": "node --env-file-if-exists=.env.local scripts/visual-check.mjs",
    "ui:audit": "node --env-file-if-exists=.env.local scripts/ui-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
