DATABASE_URL=postgresql://crm_app:replace-with-the-same-encoded-database-password@database:5432/crm
AUTH_EMAIL_OTP_ENABLED=false
# Must match the web container when AUTH_EMAIL_OTP_ENABLED=true.
# AUTH_EMAIL_OTP_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CRM_MAIL_ORGANIZATION_ID=replace-with-organization-uuid
CRM_MAIL_ADDRESS=info@tehstroinvest.ru
CRM_MAIL_IMAP_HOST=172.18.0.1
CRM_MAIL_IMAP_PORT=993
CRM_MAIL_IMAP_USER=info@tehstroinvest.ru
CRM_MAIL_IMAP_PASSWORD=replace-with-private-mailbox-password
CRM_MAIL_TLS_SERVERNAME=mail.tehstroinvest.ru
CRM_MAIL_SMTP_HOST=172.18.0.1
CRM_MAIL_SMTP_PORT=587
CRM_MAIL_SMTP_USER=info@tehstroinvest.ru
CRM_MAIL_SMTP_PASSWORD=replace-with-private-mailbox-password
CRM_MAIL_FROM=info@tehstroinvest.ru
CRM_PUBLIC_ORIGIN=https://workspace-90780.tehstroinvest.ru
# For more than one domain, replace CRM_MAIL_ADDRESS and CRM_MAIL_IMAP_* with
